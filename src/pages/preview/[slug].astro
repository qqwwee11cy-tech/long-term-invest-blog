---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getDraftPosts, formatDate } from '../../lib/posts';
import { CATEGORIES } from '../../consts';

// 승인 전 초안 미리보기. 목록·RSS·사이트맵에는 나오지 않고 검색엔진에도 안 잡힙니다.
export async function getStaticPaths() {
  const posts = await getDraftPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, category, tags } = post.data;
---
<Base title={`[미리보기] ${title}`} description={description} noindex>
  <p class="banner">아직 게시 전인 미리보기예요. 메일의 승인 버튼을 누르면 블로그에 올라가요.</p>
  <article>
    <p class="muted cat">{CATEGORIES[category].name}</p>
    <h1>{title}</h1>
    <p class="muted meta"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></p>
    <div class="body"><Content /></div>
    {tags.length > 0 && (
      <p class="tags">{tags.map((t) => <span class="tag">#{t}</span>)}</p>
    )}
  </article>
</Base>
<style>
  .banner { background: #fff4d6; color: #5b4a12; border-radius: 10px; padding: .75rem 1rem; font-size: .95rem; }
  .cat { margin: 0; font-size: .9rem; }
  h1 { margin: .25rem 0; font-size: 1.9rem; }
  .meta { margin: 0 0 2rem; font-size: .9rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 2.5rem; }
</style>
