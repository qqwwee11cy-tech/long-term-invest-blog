---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts } from '../../lib/posts';
import { CATEGORIES, type CategoryKey } from '../../consts';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const key = Astro.params.category as CategoryKey;
const cat = CATEGORIES[key];
const posts = (await getPublishedPosts()).filter((p) => p.data.category === key);
---
<Base title={cat.name} description={cat.description}>
  <h1>{cat.name}</h1>
  <p class="muted">{cat.description}</p>
  <PostList posts={posts} />
</Base>
