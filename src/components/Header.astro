---
import { SITE_TITLE, CATEGORIES } from '../consts';
const path = Astro.url.pathname;
const links = [
  ...Object.entries(CATEGORIES).map(([key, c]) => ({ href: `/category/${key}/`, label: c.name })),
  { href: '/tools/', label: '투자 도구' },
  { href: '/about/', label: '소개' },
];
---
<header>
  <div class="wrap">
    <a class="brand" href="/">{SITE_TITLE}</a>
    <nav>
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  header { border-bottom: 1px solid var(--border); background: var(--surface); }
  .wrap { max-width: var(--max); margin: 0 auto; padding: .9rem 1rem; display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; align-items: center; justify-content: space-between; }
  .brand { font-weight: 800; font-size: 1.15rem; color: var(--text); text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem 1rem; }
  nav a { color: var(--muted); text-decoration: none; font-size: .95rem; }
  nav a[aria-current='page'], nav a:hover { color: var(--accent); }
</style>
